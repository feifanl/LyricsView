{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyricsView",
  "version": "0.1.0",
  "identifier": "com.lyricsview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "focus": false,
        "width": 800,
        "height": 220,
        "backgroundColor": "#00000000"
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "LyricsView",
        "visible": false,
        "resizable": true,
        "width": 920,
        "height": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
